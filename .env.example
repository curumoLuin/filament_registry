# Supabase project settings -> API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: enables LLM-based datasheet extraction.
# Without it the app falls back to the built-in deterministic parser.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Used only by tests/e2e
E2E_EMAIL=owner@example.com
E2E_PASSWORD=change-me-please
